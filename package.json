{
  "name": "onetag-framer-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pack": "npm run build && framer-plugin-tools pack",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@framer/plugin": "^4",
    "react": "^18",
    "react-dom": "^18",
    "vite-plugin-mkcert": "^1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "framer-plugin-tools": "^1.2.3",
    "globals": "^15.9.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8.0.1",
    "vite": "^8",
    "vite-plugin-framer": "^1.1.0"
  },
  "description": "Framer plugin that adds the OneTag AI Ask AI box to every page of a Framer site.",
  "license": "MIT",
  "author": "OneTag AI (https://onetagai.com)",
  "homepage": "https://onetagai.com/?ref=framer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengyiqicoder/onetag-framer-plugin.git"
  },
  "bugs": "https://github.com/fengyiqicoder/onetag-framer-plugin/issues"
}
